package com.example.jr_call

import android.Manifest
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Person
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.media.AudioAttributes
import android.media.RingtoneManager
import android.os.Build
import android.util.Log
import androidx.core.app.NotificationCompat
import androidx.core.app.NotificationManagerCompat
import androidx.core.content.ContextCompat
import com.google.firebase.messaging.RemoteMessage
import org.json.JSONObject

class JRCallIncomingMessageReceiver : BroadcastReceiver() {

    companion object {
        private const val TAG = "JRCallIncomingFCM"

        private const val INCOMING_CHANNEL_ID =
            "jr_call_incoming_calls"

        private const val INCOMING_CHANNEL_NAME =
            "JR CALL Incoming Calls"

        private const val INCOMING_NOTIFICATION_ID =
            41001

        private const val PREFS_NAME =
            "jr_call_background_call"

        private const val PREF_PENDING_CALL =
            "pending_call"

        private const val EXTRA_CALL_ID =
            "jr_call_call_id"

        private const val EXTRA_CALL_ACTION =
            "jr_call_action"

        private const val ACTION_OPEN = "open"
        private const val ACTION_ACCEPT = "accept"
        private const val ACTION_REJECT = "reject"

        private const val FULL_SCREEN_PERMISSION =
            "android.permission.USE_FULL_SCREEN_INTENT"
    }

    override fun onReceive(
        context: Context,
        intent: Intent
    ) {
        try {
            val extras = intent.extras ?: return

            val remoteMessage =
                RemoteMessage(extras)

            val data =
                remoteMessage.data

            if (!isIncomingCall(data)) {
                return
            }

            val appContext =
                context.applicationContext ?: context

            val posted =
                presentIncomingCall(
                    appContext,
                    data
                )

            Log.d(
                TAG,
                "Incoming call presentation posted=$posted callId=${data["callId"] ?: ""}"
            )
        } catch (error: Throwable) {
            Log.e(
                TAG,
                "Incoming call presentation failed.",
                error
            )
        }
    }

    private fun isIncomingCall(
        data: Map<String, String>
    ): Boolean {
        val type =
            (
                data["type"]
                    ?: data["event"]
                    ?: data["notificationType"]
                    ?: ""
            )
                .trim()
                .lowercase()

        if (
            type == "incoming_call" ||
            type == "incoming-call" ||
            type == "incomingcall" ||
            type == "call" ||
            type == "voice_call" ||
            type == "video_call"
        ) {
            return true
        }

        return !data["callId"].isNullOrBlank() &&
            !data["callerId"].isNullOrBlank() &&
            !data["receiverId"].isNullOrBlank()
    }

    private fun presentIncomingCall(
        context: Context,
        data: Map<String, String>
    ): Boolean {
        val callId =
            data["callId"]
                ?.trim()
                ?.takeIf { it.isNotEmpty() }
                ?: return false

        val callerId =
            (
                data["callerId"]
                    ?: data["callerUid"]
                    ?: data["senderId"]
            )
                ?.trim()
                ?.takeIf { it.isNotEmpty() }
                ?: return false

        val receiverId =
            (
                data["receiverId"]
                    ?: data["receiverUid"]
                    ?: data["recipientId"]
            )
                ?.trim()
                ?.takeIf { it.isNotEmpty() }
                ?: return false

        val callerName =
            (
                data["callerName"]
                    ?: data["senderName"]
                    ?: "JR CALL User"
            )
                .trim()
                .ifEmpty {
                    "JR CALL User"
                }

        val isVideoCall =
            readBoolean(
                data["isVideoCall"]
                    ?: data["video"]
                    ?: data["callType"]
            )

        createIncomingChannel(context)

        if (!canPostNotifications(context)) {
            return false
        }

        savePendingCall(
            context = context,
            data = data,
            callId = callId,
            callerId = callerId,
            receiverId = receiverId,
            callerName = callerName,
            isVideoCall = isVideoCall
        )

        val openPendingIntent =
            createPendingIntent(
                context,
                callId,
                ACTION_OPEN,
                1
            )

        val acceptPendingIntent =
            createPendingIntent(
                context,
                callId,
                ACTION_ACCEPT,
                2
            )

        val rejectPendingIntent =
            createPendingIntent(
                context,
                callId,
                ACTION_REJECT,
                3
            )

        val notification =
            if (
                Build.VERSION.SDK_INT >=
                Build.VERSION_CODES.S
            ) {
                val caller =
                    Person.Builder()
                        .setName(callerName)
                        .setImportant(true)
                        .build()

                val builder =
                    Notification.Builder(
                        context,
                        INCOMING_CHANNEL_ID
                    )
                        .setSmallIcon(
                            context.applicationInfo.icon
                        )
                        .setContentTitle(
                            if (isVideoCall) {
                                "Incoming Video Call"
                            } else {
                                "Incoming Voice Call"
                            }
                        )
                        .setContentText(
                            "$callerName is calling you"
                        )
                        .setCategory(
                            Notification.CATEGORY_CALL
                        )
                        .setVisibility(
                            Notification.VISIBILITY_PUBLIC
                        )
                        .setOngoing(true)
                        .setAutoCancel(false)
                        .setContentIntent(
                            openPendingIntent
                        )
                        .setStyle(
                            Notification.CallStyle
                                .forIncomingCall(
                                    caller,
                                    rejectPendingIntent,
                                    acceptPendingIntent
                                )
                        )
                        .addPerson(caller)
                        .setTimeoutAfter(
                            45_000L
                        )

                if (canUseFullScreenIntent(context)) {
                    builder.setFullScreenIntent(
                        openPendingIntent,
                        true
                    )
                }

                builder.build()
            } else {
                val builder =
                    NotificationCompat.Builder(
                        context,
                        INCOMING_CHANNEL_ID
                    )
                        .setSmallIcon(
                            context.applicationInfo.icon
                        )
                        .setContentTitle(
                            if (isVideoCall) {
                                "Incoming Video Call"
                            } else {
                                "Incoming Voice Call"
                            }
                        )
                        .setContentText(
                            "$callerName is calling you"
                        )
                        .setCategory(
                            NotificationCompat.CATEGORY_CALL
                        )
                        .setPriority(
                            NotificationCompat.PRIORITY_MAX
                        )
                        .setVisibility(
                            NotificationCompat.VISIBILITY_PUBLIC
                        )
                        .setOngoing(true)
                        .setAutoCancel(false)
                        .setContentIntent(
                            openPendingIntent
                        )
                        .addAction(
                            android.R.drawable
                                .ic_menu_close_clear_cancel,
                            "Decline",
                            rejectPendingIntent
                        )
                        .addAction(
                            android.R.drawable
                                .sym_action_call,
                            "Accept",
                            acceptPendingIntent
                        )

                if (canUseFullScreenIntent(context)) {
                    builder.setFullScreenIntent(
                        openPendingIntent,
                        true
                    )
                }

                builder.build()
            }

        return try {
            NotificationManagerCompat
                .from(context)
                .notify(
                    INCOMING_NOTIFICATION_ID,
                    notification
                )

            true
        } catch (_: SecurityException) {
            false
        }
    }

    private fun createPendingIntent(
        context: Context,
        callId: String,
        action: String,
        suffix: Int
    ): PendingIntent {
        val intent =
            Intent(
                context,
                MainActivity::class.java
            ).apply {
                flags =
                    Intent.FLAG_ACTIVITY_NEW_TASK or
                    Intent.FLAG_ACTIVITY_SINGLE_TOP or
                    Intent.FLAG_ACTIVITY_CLEAR_TOP

                putExtra(
                    EXTRA_CALL_ID,
                    callId
                )

                putExtra(
                    EXTRA_CALL_ACTION,
                    action
                )
            }

        return PendingIntent.getActivity(
            context,
            requestCode(
                callId,
                suffix
            ),
            intent,
            PendingIntent.FLAG_UPDATE_CURRENT or
                PendingIntent.FLAG_IMMUTABLE
        )
    }

    private fun savePendingCall(
        context: Context,
        data: Map<String, String>,
        callId: String,
        callerId: String,
        receiverId: String,
        callerName: String,
        isVideoCall: Boolean
    ) {
        val json =
            JSONObject()

        data.forEach {
            (key, value) ->
            json.put(
                key,
                value
            )
        }

        json.put(
            "callId",
            callId
        )

        json.put(
            "callerId",
            callerId
        )

        json.put(
            "receiverId",
            receiverId
        )

        json.put(
            "callerName",
            callerName
        )

        json.put(
            "isVideoCall",
            isVideoCall
        )

        context
            .getSharedPreferences(
                PREFS_NAME,
                Context.MODE_PRIVATE
            )
            .edit()
            .putString(
                PREF_PENDING_CALL,
                json.toString()
            )
            .apply()
    }

    private fun createIncomingChannel(
        context: Context
    ) {
        if (
            Build.VERSION.SDK_INT <
            Build.VERSION_CODES.O
        ) {
            return
        }

        val manager =
            context.getSystemService(
                NotificationManager::class.java
            )

        val ringtone =
            RingtoneManager.getDefaultUri(
                RingtoneManager.TYPE_RINGTONE
            )

        val audioAttributes =
            AudioAttributes.Builder()
                .setUsage(
                    AudioAttributes
                        .USAGE_NOTIFICATION_RINGTONE
                )
                .setContentType(
                    AudioAttributes
                        .CONTENT_TYPE_SONIFICATION
                )
                .build()

        val channel =
            NotificationChannel(
                INCOMING_CHANNEL_ID,
                INCOMING_CHANNEL_NAME,
                NotificationManager.IMPORTANCE_HIGH
            ).apply {
                description =
                    "Incoming JR CALL voice and video calls"

                enableVibration(true)

                lockscreenVisibility =
                    Notification.VISIBILITY_PUBLIC

                setSound(
                    ringtone,
                    audioAttributes
                )
            }

        manager.createNotificationChannel(
            channel
        )
    }

    private fun canPostNotifications(
        context: Context
    ): Boolean {
        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.TIRAMISU
        ) {
            if (
                ContextCompat.checkSelfPermission(
                    context,
                    Manifest.permission.POST_NOTIFICATIONS
                ) != PackageManager.PERMISSION_GRANTED
            ) {
                return false
            }
        }

        return NotificationManagerCompat
            .from(context)
            .areNotificationsEnabled()
    }

    private fun canUseFullScreenIntent(
        context: Context
    ): Boolean {
        if (
            Build.VERSION.SDK_INT <
            Build.VERSION_CODES.Q
        ) {
            return true
        }

        if (
            ContextCompat.checkSelfPermission(
                context,
                FULL_SCREEN_PERMISSION
            ) != PackageManager.PERMISSION_GRANTED
        ) {
            return false
        }

        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.UPSIDE_DOWN_CAKE
        ) {
            val manager =
                context.getSystemService(
                    NotificationManager::class.java
                )

            return manager
                .canUseFullScreenIntent()
        }

        return true
    }

    private fun readBoolean(
        value: String?
    ): Boolean {
        return when (
            value
                ?.trim()
                ?.lowercase()
        ) {
            "true",
            "1",
            "yes",
            "video" ->
                true

            else ->
                false
        }
    }

    private fun requestCode(
        callId: String,
        suffix: Int
    ): Int {
        return (
            31 *
                callId.hashCode()
            ) + suffix
    }
}